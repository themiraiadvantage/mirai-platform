{
  "name": "mirai-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mirai/frontend",
    "dev:api": "npm run start:dev --workspace @mirai/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run db:migrate --workspace @mirai/backend",
    "start": "npm run start --workspace @mirai/frontend",
    "start:api": "npm run start --workspace @mirai/backend"
  }
}
