{
  "name": "@mirai/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && tsc-watch -p tsconfig.json --onFirstSuccess \"node --watch --watch-preserve-output dist/main.js\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:bootstrap": "node scripts/bootstrap-admin.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "smtp:verify": "node scripts/verify-smtp.cjs",
    "test:e2e": "npm run build && node scripts/test-e2e.cjs",
    "mail:preview": "npm run build && node scripts/preview-email.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^7.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
